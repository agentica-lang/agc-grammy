# A Python subset for grammy, with real indentation blocks.
#
# `suite = >_{ ... }` opens an indentation scope: grammy remembers the
# indentation of the line the suite starts on, and the `INDENT`/`SAME` builtins
# consume the next line's indentation and compare it with that scope. No input
# is rewritten, so spans and error columns stay exact.
#
# Supported: numbers, text, True/False, names, print(...), `+ - * /`,
# comparisons, `and`, `or`, `not`, parentheses, assignment, `if`/`elif`/`else`
# and `while`. Rules marked `_` build no node.

nl = _{ "\r\n" | "\n" | "\r" }
ws = _{ (" " | "\t")* }
eol = _{ ws ~ ("#" ~ [^\n]*)? ~ nl }

ident_start = _{ [a-zA-Z_] }
ident_char = _{ [a-zA-Z0-9_] }
word_end = _{ !ident_char }

program = _{ skipped* ~ (top ~ skipped*)* ~ ws ~ EOF }
skipped = _{ (" " | "\t")* ~ ("#" ~ [^\n]*)? ~ nl }
top = _{ statement ~ (eol | ws ~ EOF) }

statement = _{ simple | if_stmt | while_loop | comment }
comment = _{ "#" ~ [^\n]* }
simple = _{ assign | call_stmt }
assign = { name ~ ws ~ "=" ~ ws ~ expr }
call_stmt = { call }

if_stmt = { "if" ~ ws ~ expr ~ ws ~ ":" ~ suite ~ elif_branch* ~ else_branch? }
elif_branch = { eol ~ SAME ~ "elif" ~ ws ~ expr ~ ws ~ ":" ~ suite }
else_branch = { eol ~ SAME ~ "else" ~ ws ~ ":" ~ suite }
while_loop = { "while" ~ ws ~ expr ~ ws ~ ":" ~ suite }
suite = >_{ eol ~ INDENT ~ statement ~ (eol ~ INDENT ~ statement)* }

expr = _{ or_expr }
or_expr = { and_expr ~ (ws ~ "or" ~ word_end ~ ws ~ and_expr)* }
and_expr = { not_expr ~ (ws ~ "and" ~ word_end ~ ws ~ not_expr)* }
not_expr = _{ boolean_not | comparison }
boolean_not = { "not" ~ word_end ~ ws ~ not_expr }
comparison = { sum ~ (ws ~ cmp_op ~ ws ~ sum)? }
cmp_op = { "==" | "!=" | "<=" | ">=" | "<" | ">" }
sum = { term ~ (ws ~ add_op ~ ws ~ term)* }
add_op = { "+" | "-" }
term = { unary ~ (ws ~ mul_op ~ ws ~ unary)* }
mul_op = { "*" | "/" }
unary = _{ minus | atom }
minus = { "-" ~ ws ~ unary }

atom = _{ number | text | boolean | call | name | group }
group = { "(" ~ ws ~ expr ~ ws ~ ")" }
call = { name ~ "(" ~ ws ~ (args ~ ws)? ~ ")" }
args = _{ expr ~ (ws ~ "," ~ ws ~ expr)* }

number = { ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
text = { "\"" ~ [^"\n]* ~ "\"" | "'" ~ [^'\n]* ~ "'" }
boolean = { ("True" | "False") ~ word_end }
name = { ident_start ~ ident_char* }
