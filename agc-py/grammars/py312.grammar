// Python 3.12, typed subset, phase 2: typed `def`, annotations, data
// forms (subscripts, slices, attributes, full strings and numbers) and an
// expression and control core.
//
// Explicit `ws` and `eol` keep physical line boundaries visible to
// INDENT/SAME. Structural rules build nodes; layout helpers are silent.

// Only bracketed syntax enables joined lines. The empty stack marker
// consumes no input, and each closing delimiter drops its own marker.
hws = _{ (" " | "\t")* }

ws = _{ hws ~ joined_line* }

joined_line = _{ &("#" | nl) ~ PEEK ~ comment? ~ nl ~ hws }

// A token that used to require adjacency can also follow a joined line.
joined_break = _{ (hws ~ joined_line+)? }

open_paren = _{ "(" ~ PUSH_LITERAL("") }

open_list = _{ "[" ~ PUSH_LITERAL("") }

open_dict = _{ "{" ~ PUSH_LITERAL("") }

nl = _{ "\r\n" | "\n" | "\r" }

// Physical statement boundaries never use bracket-sensitive whitespace.
eol = _{ hws ~ comment? ~ nl }

skipped = _{ eol }

ident_start = _{ [a-zA-Z_] }

ident_char = _{ [a-zA-Z0-9_] }

ident = _{ ident_start ~ ident_char* }

// After a keyword, so `defined` is not `def` + `ined`.
word_end = _{ !ident_char }

program = _{ skipped* ~ (import_stmt ~ top_end ~ skipped*)* ~ (top ~ skipped*)* ~ ws ~ EOF }

// Imports are handled separately in the module preamble.
top = _{ (def_stmt | statement) ~ top_end }

top_end = _{ eol | hws ~ comment? ~ EOF }

import_stmt = { import_modules | from_import }

import_modules = _{ "import" ~ word_end ~ hws ~ import_module ~ (hws ~ "," ~ hws ~ import_module)* }

import_module = { dotted ~ import_alias? }

import_alias = { ws ~ "as" ~ word_end ~ ws ~ name }

from_import = _{ "from" ~ word_end ~ hws ~ dotted ~ hws ~ "import" ~ word_end ~ hws ~ import_names }

import_names = _{ open_paren ~ ws ~ import_items ~ (ws ~ ",")? ~ ws ~ ")" ~ DROP | import_items }

import_items = _{ import_item ~ (ws ~ "," ~ ws ~ import_item)* }

import_item = { name ~ import_alias? }

type_alias = { "type" ~ word_end ~ hws ~ name ~ hws ~ "=" ~ hws ~ annotation }

statement = _{
  !continue_keyword ~ !match_header ~ !case_header ~ (
    annotated
    | augmented_assign
    | type_alias
    | assign
    | return_stmt
    | pass_stmt
    | if_stmt
    | while_loop
    | for_loop
    | try_stmt
    | raise_stmt
    | assert_stmt
    | break_stmt
    | next_stmt
    | call_stmt
    | comment
    | expr_stmt
  )
}

// Check at the header start so the diagnostic points at the soft keyword.
match_header = _{ "match" ~ word_end ~ ws ~ expr ~ ws ~ ":" }

case_header = _{ "case" ~ word_end ~ ws ~ (expr | "...") ~ ws ~ ":" }

// Bare excluded statements must not fall back to name expressions.
expr_stmt = { !(("raise" | "yield") ~ word_end ~ top_end) ~ expr }

// Reject the statement spelling, not the same text in a name position.
continue_keyword = _{ "continue" ~ word_end ~ (eol | hws ~ comment? ~ EOF) }

suite = >_{ eol ~ INDENT ~ statement ~ (eol ~ INDENT ~ statement)* }

// `def name(params) -> type:` — annotations are mandatory, so an untyped
// `def` fails here with the deepest span. `*args` has no rule and fails too.
def_stmt = {
  "def" ~ word_end ~ ws ~ name ~ open_paren ~ ws ~ params? ~ ws ~ ")" ~ DROP ~
  ws ~ "->" ~ ws ~ annotation ~ ws ~ ":" ~ suite
}

params = { param ~ (ws ~ "," ~ ws ~ param)* ~ (ws ~ ",")? }

param = { name ~ ws ~ ":" ~ ws ~ annotation ~ (ws ~ "=" ~ ws ~ expr)? }

return_stmt = { "return" ~ word_end ~ (ws ~ expr)? }

pass_stmt = { "pass" ~ word_end }

annotated = { name ~ ws ~ ":" ~ ws ~ annotation ~ (ws ~ "=" ~ ws ~ expr)? }

assign = { name ~ ws ~ "=" ~ ws ~ expr }

augmented_assign = { name ~ ws ~ aug_op ~ ws ~ expr }

aug_op = { "+=" | "-=" | "*=" | "/=" | "%=" }

// Preserve the original statement shape for a standalone named call.
call_stmt = { call ~ &top_end }

// `>` scopes the whole branch chain: `suite` alone would drop its base when
// it returns, so `elif`/`else` in a `def` body would compare against the
// wrong level. The base is the `if` line; expressions never consult it.
if_stmt = >{ "if" ~ ws ~ expr ~ ws ~ ":" ~ suite ~ elif_branch* ~ else_branch? }

elif_branch = { eol ~ SAME ~ "elif" ~ ws ~ expr ~ ws ~ ":" ~ suite }

else_branch = { eol ~ SAME ~ "else" ~ ws ~ ":" ~ suite }

while_loop = { "while" ~ ws ~ expr ~ ws ~ ":" ~ suite }

for_loop = { "for" ~ word_end ~ ws ~ name ~ ws ~ "in" ~ word_end ~ ws ~ expr ~ ws ~ ":" ~ suite }

break_stmt = { "break" ~ word_end }

next_stmt = { "next" ~ word_end }

// The handler must start at the indentation of its try header.
try_stmt = >{ "try" ~ word_end ~ ws ~ ":" ~ suite ~ except_handler }

except_handler = { eol ~ SAME ~ "except" ~ word_end ~ (ws ~ name ~ (ws ~ "as" ~ word_end ~ ws ~ name)?)? ~ ws ~ ":" ~ suite }

// Report unsupported `from` at the clause without consuming trailing blanks.
raise_stmt = { "raise" ~ word_end ~ ws ~ expr ~ &(ws ~ !raise_cause) }

raise_cause = _{ "from" ~ word_end }

assert_stmt = { "assert" ~ word_end ~ ws ~ expr ~ (ws ~ "," ~ ws ~ expr)? }

comment = _{ "#" ~ [^"\r\n"]* }

// Annotations: unions of arms; a string arm is a forward reference.
annotation = { union }

union = { union_arm ~ (ws ~ "|" ~ ws ~ union_arm)* }

union_arm = { subscript | fwd | dotted }

subscript = { dotted ~ joined_break ~ open_list ~ ws ~ type_args ~ (ws ~ ",")? ~ ws ~ "]" ~ DROP }

type_args = { annotation ~ (ws ~ "," ~ ws ~ annotation)* }

dotted = { ident ~ (joined_break ~ "." ~ joined_break ~ ident)* }

fwd = { "\"" ~ [^"\"\n"]* ~ "\"" | "'" ~ [^"'\n"]* ~ "'" }

expr = _{ cond_expr }

cond_expr = { or_expr ~ (ws ~ "if" ~ word_end ~ ws ~ or_expr ~ ws ~ "else" ~ word_end ~ ws ~ cond_expr)? }

or_expr = { and_expr ~ (ws ~ "or" ~ word_end ~ ws ~ and_expr)* }

and_expr = { not_expr ~ (ws ~ "and" ~ word_end ~ ws ~ not_expr)* }

not_expr = _{ boolean_not | comparison }

boolean_not = { "not" ~ word_end ~ ws ~ not_expr }

comparison = { sum ~ (ws ~ cmp_op ~ ws ~ sum)* }

cmp_op = {
  "==" | "!=" | "<=" | ">=" | "<" | ">"
  | "not" ~ word_end ~ ws ~ "in" ~ word_end
  | "in" ~ word_end
  | "is" ~ word_end ~ (ws ~ "not" ~ word_end)?
}

sum = { term ~ (ws ~ add_op ~ ws ~ term)* }

add_op = { "+" | "-" }

term = { unary ~ (ws ~ mul_op ~ ws ~ unary)* }

mul_op = { "*" | "//" | "/" | "%" }

unary = _{ minus | plus | atom ~ power? }

plus = { "+" ~ ws ~ unary }

// The right operand can itself have a power, or start with a unary sign.
power = { ws ~ "**" ~ ws ~ unary }

minus = { "-" ~ ws ~ unary }

atom = _{ postfix }

group = { open_paren ~ ws ~ expr ~ ws ~ ")" ~ DROP }

attr = { name ~ (joined_break ~ "." ~ joined_break ~ ident)+ }

// Keep the original call and name nodes for bare named calls. The head
// then takes trailers in order, dispatched by their opening character.
call = { (attr | name) ~ joined_break ~ call_body }

call_body = _{ open_paren ~ ws ~ (args ~ ws ~ ","? ~ ws)? ~ ")" ~ DROP }

postfix = _{ postfix_head ~ (joined_break ~ postfix_trailer)* }

postfix_head = _{ number | text | list_lit | dict_lit | boolean | none_lit | named_primary | group }

// A malformed named call must not retry its arguments as a trailer.
named_primary = _{ call | !(ident ~ (joined_break ~ "." ~ joined_break ~ ident)* ~ joined_break ~ "(") ~ (attr | name) }

postfix_trailer = _{ call_trailer | index | attr_trailer }

call_trailer = { call_body }

attr_trailer = { "." ~ joined_break ~ ident }

// Parse the lower expression once, then decide between index and slice
// at the colon. A literal negative lower bound can only be an index.
index = { open_list ~ ws ~ (negative_index | !negative_literal ~ expr ~ (ws ~ slice)? | slice) ~ ws ~ "]" ~ DROP }

negative_index = _{ &negative_literal ~ expr ~ &(ws ~ "]") }

negative_literal = _{ negative_value ~ &(ws ~ (":" | "]")) }

negative_value = _{ "-" ~ ws ~ number | open_paren ~ ws ~ negative_value ~ ws ~ ")" ~ DROP }

slice = { ":" ~ ws ~ (!negative_literal ~ expr)? }

// Once a keyword appears, reject an immediately following positional
// argument. Keep the existing `arg` wrappers in mixed calls.
args = _{ kwarg ~ (ws ~ "," ~ ws ~ kwarg)* | !kwarg_head ~ expr ~ (ws ~ "," ~ ws ~ arg)* }

arg = { kwarg ~ !(ws ~ "," ~ ws ~ !kwarg_head ~ !")") | !kwarg_head ~ expr }

kwarg_head = _{ ident ~ ws ~ "=" ~ !"=" }

kwarg = { &kwarg_head ~ name ~ ws ~ "=" ~ ws ~ expr }

// A list (`[1, x]`, `[]`) or dict (`{"k": v}`, `{}`) literal, with an
// optional trailing comma. Also a postfix head, so `[1][0]`, `{"k": 1}["k"]`
// and `"sep".join(xs)` chain like names do.
list_lit = { open_list ~ ws ~ (expr ~ (ws ~ "," ~ ws ~ expr)* ~ (ws ~ ",")? ~ ws)? ~ "]" ~ DROP }

dict_lit = { open_dict ~ ws ~ (dict_entry ~ (ws ~ "," ~ ws ~ dict_entry)* ~ (ws ~ ",")? ~ ws)? ~ "}" ~ DROP }

dict_entry = { expr ~ ws ~ ":" ~ ws ~ expr }

// Integers in decimal, hex, octal and binary with `_` separators; floats
// with exponents and leading/trailing dots per Python. Each prefixed form
// precedes the plain decimal run, so `0xFF` never lexes as `0` plus a name.
number = { hex_num | oct_num | bin_num | float_num | decimal_int }

decimal_int = _{ "0" ~ ("_" ~ "0")* | [1-9] ~ ("_"? ~ ASCII_DIGIT)* }

hex_num = _{ "0" ~ ("x" | "X") ~ "_"? ~ ASCII_HEX_DIGIT ~ (("_")? ~ ASCII_HEX_DIGIT)* }

oct_num = _{ "0" ~ ("o" | "O") ~ "_"? ~ ASCII_OCT_DIGIT ~ (("_")? ~ ASCII_OCT_DIGIT)* }

bin_num = _{ "0" ~ ("b" | "B") ~ "_"? ~ ASCII_BIN_DIGIT ~ (("_")? ~ ASCII_BIN_DIGIT)* }

float_num = _{
  decimal_int ~ "." ~ (ASCII_DIGIT ~ (("_")? ~ ASCII_DIGIT)*)? ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT ~ (("_")? ~ ASCII_DIGIT)*)?
  | "." ~ ASCII_DIGIT ~ (("_")? ~ ASCII_DIGIT)* ~ (("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT ~ (("_")? ~ ASCII_DIGIT)*)?
  | decimal_int ~ ("e" | "E") ~ ("+" | "-")? ~ ASCII_DIGIT ~ (("_")? ~ ASCII_DIGIT)*
}

// Strings: plain, raw (`r` keeps backslashes literal; a trailing lone `\`
// still fails because `"\\" ~ .` needs the second character) and
// interpolated (`f` holes hold subset expressions, `{{`/`}}` spell literal
// braces, a lone `}` fails). Triple-quoted forms span lines through `.`;
// single-quoted forms stop at the line break. `b` strings have no arm and
// fail; `\N{...}` is not an `escape` arm, so it fails too (both excluded
// per SUBSET sections 3 and 8).
text = { f_string | r_string | plain_string }

f_string = _{
  ("f" | "F") ~ (
    "\"\"\"" ~ (escape | "{{" | "}}" | hole | !"\"\"\"" ~ [^"\\{}"])* ~ "\"\"\""
    | "'''" ~ (escape | "{{" | "}}" | hole | !"'''" ~ [^"\\{}"])* ~ "'''"
    | "\"" ~ (escape | "{{" | "}}" | hole | [^"\"\\{}\n"])* ~ "\""
    | "'" ~ (escape | "{{" | "}}" | hole | [^"'\\{}\n"])* ~ "'"
  )
}

// Hide any enclosing bracket marker; only brackets inside the hole join.
hole = { "{" ~ PUSH_LITERAL("}") ~ ws ~ expr ~ ws ~ "}" ~ DROP }

r_string = _{
  ("r" | "R") ~ (
    "\"\"\"" ~ ("\\" ~ . | !"\"\"\"" ~ [^"\\"])* ~ "\"\"\""
    | "'''" ~ ("\\" ~ . | !"'''" ~ [^"\\"])* ~ "'''"
    | "\"" ~ ("\\" ~ [^"\n"] | [^"\"\\\n"])* ~ "\""
    | "'" ~ ("\\" ~ [^"\n"] | [^"'\\\n"])* ~ "'"
  )
}

plain_string = _{
  "\"\"\"" ~ (escape | !"\"\"\"" ~ [^"\\"])* ~ "\"\"\""
  | "'''" ~ (escape | !"'''" ~ [^"\\"])* ~ "'''"
  | "\"" ~ (escape | [^"\"\\\n"])* ~ "\""
  | "'" ~ (escape | [^"'\\\n"])* ~ "'"
}

// The SUBSET escape set: `\n \r \t \\ \" \' \0 \a \b \f \v \xNN
// \uNNNN`. `\N{...}` and `\U........` have no arm here and fail.
escape = _{
  "\\" ~ (
    "n" | "r" | "t" | "\\" | "\"" | "'" | "0" | "a" | "b" | "f" | "v"
    | "x" ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT
    | "u" ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT ~ ASCII_HEX_DIGIT
  )
}

boolean = { ("True" | "False") ~ word_end }

none_lit = { "None" ~ word_end }

name = { ident_start ~ ident_char* }
